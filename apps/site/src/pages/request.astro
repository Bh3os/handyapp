---
// The estimate request form (TSK-0026, TSK-0027; HH-INT-01, HH-INT-08, HH-INT-09, HH-INT-15, HH-SVC-03, C02). A React
// island; it needs the browser (the draft lives in this browser only), so it renders on the client. The services it
// offers, with their questions, come from the API (GET /api/v1/public/services): only services the public site may show
// (OWN-DEC-84), with their registry names and intake inputs.
import '@handyhub/ui/styles.css'
import '../request/request.css'
import { customerTranslator } from '@handyhub/i18n'
import RequestWizard from '../request/RequestWizard.tsx'

const title = customerTranslator().t('request.title')
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | HandyHub</title>
  </head>
  <body>
    <main class="hh-request-page">
      <h1 class="hh-h1">{title}</h1>
      <RequestWizard client:only="react" />
    </main>
  </body>
</html>

{
  "openapi": "3.1.0",
  "info": {
    "title": "HandyApp API",
    "version": "1",
    "description": "Generated from the registered routes (TSK-0010, HH-API-01). Errors use one envelope (HH-API-03); private responses are not cached."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/public/request-form": {
      "get": {
        "operationId": "getRequestFormSettings",
        "summary": "Request form settings",
        "description": "Public read of the configured request-draft period (session.timings.requestDraftDays, FACT-SESSION-TIMINGS), the business time zone and the service limit. draftDays is null while the value is NOT CONFIGURED; the wizard then keeps no draft.",
        "tags": [
          "requests"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "draftDays",
                    "maxServices",
                    "timeZone"
                  ],
                  "properties": {
                    "draftDays": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "maxServices": {
                      "type": "integer"
                    },
                    "timeZone": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-handyhub": {
          "actors": [
            "guest",
            "customer"
          ],
          "permission": "request.submit",
          "kind": "read",
          "idempotency": "none",
          "expectedVersion": "none",
          "rateLimit": "none",
          "audit": "none",
          "pagination": false,
          "cache": "private, no-store",
          "test": "test/integration/requests.test.ts"
        }
      }
    },
    "/api/v1/public/requests": {
      "post": {
        "operationId": "submitRequest",
        "summary": "Send Estimate Request",
        "description": "Guest or customer submission. One transaction creates a new customer, contact, property, project (not a job or appointment) and the request with its services and answers, plus one request.submitted outbox event. Never matched to existing customers. The same Idempotency-Key returns the same request; a changed body is a 409. Rate limited per client network with a neutral 429. Spam signals only flag the request for review.",
        "tags": [
          "requests"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "formVersion",
                  "privacyNoticeVersion",
                  "services",
                  "notSure",
                  "property",
                  "timing",
                  "estimatePreference",
                  "contact",
                  "smsOptIn",
                  "marketingOptIn"
                ],
                "properties": {
                  "formVersion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,40}$"
                  },
                  "privacyNoticeVersion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]{1,40}$"
                  },
                  "services": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "serviceId"
                      ],
                      "properties": {
                        "serviceId": {
                          "type": "string",
                          "pattern": "^SVC-[A-Z]{2}-[0-9]{2}$"
                        },
                        "notes": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        }
                      }
                    }
                  },
                  "notSure": {
                    "type": "boolean"
                  },
                  "otherServicesText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "answers": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "question",
                        "kind"
                      ],
                      "properties": {
                        "serviceId": {
                          "type": "string",
                          "pattern": "^SVC-[A-Z]{2}-[0-9]{2}$"
                        },
                        "question": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,63}$"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "number",
                            "text",
                            "unknown"
                          ]
                        },
                        "number": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "unit": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]{0,23}$"
                        },
                        "approximate": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "property": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "street",
                      "city",
                      "state",
                      "zip",
                      "propertyType"
                    ],
                    "properties": {
                      "street": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 50
                      },
                      "city": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "state": {
                        "type": "string",
                        "pattern": "^[A-Za-z]{2}$"
                      },
                      "zip": {
                        "type": "string",
                        "pattern": "^[0-9]{5}(-[0-9]{4})?$"
                      },
                      "propertyType": {
                        "type": "string",
                        "enum": [
                          "house",
                          "apartment_condo",
                          "townhouse",
                          "rental_short_term"
                        ]
                      }
                    }
                  },
                  "timing": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "flexible",
                      "needHelpToday",
                      "windows"
                    ],
                    "properties": {
                      "preferredDate": {
                        "type": "string",
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                      },
                      "flexible": {
                        "type": "boolean"
                      },
                      "needHelpToday": {
                        "type": "boolean"
                      },
                      "windows": {
                        "type": "array",
                        "maxItems": 5,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "enum": [
                            "mornings",
                            "afternoons",
                            "evenings",
                            "weekends",
                            "any_time"
                          ]
                        }
                      }
                    }
                  },
                  "estimatePreference": {
                    "type": "string",
                    "enum": [
                      "online",
                      "site_visit",
                      "let_handyhub_decide"
                    ]
                  },
                  "contact": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "fullName",
                      "email",
                      "phone",
                      "preferredChannel"
                    ],
                    "properties": {
                      "fullName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "email": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 254,
                        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
                      },
                      "phone": {
                        "type": "string",
                        "minLength": 7,
                        "maxLength": 30,
                        "pattern": "^[0-9 ()+.-]+$"
                      },
                      "preferredChannel": {
                        "type": "string",
                        "enum": [
                          "email",
                          "call",
                          "text"
                        ]
                      }
                    }
                  },
                  "smsOptIn": {
                    "type": "boolean"
                  },
                  "marketingOptIn": {
                    "type": "boolean"
                  },
                  "website": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "startedAt": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reference",
                    "submittedAt"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "received"
                      ]
                    },
                    "reference": {
                      "type": "string"
                    },
                    "submittedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-handyhub": {
          "actors": [
            "guest",
            "customer"
          ],
          "permission": "request.submit",
          "kind": "write",
          "idempotency": "required",
          "expectedVersion": "none",
          "rateLimit": {
            "bucket": "public-request-submit",
            "limit": 5,
            "windowSeconds": 3600
          },
          "audit": "request.submit",
          "pagination": false,
          "cache": "private, no-store",
          "test": "test/integration/requests.test.ts"
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "fieldErrors",
              "requestId",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_FAILED",
                  "IDEMPOTENCY_KEY_REQUIRED",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "METHOD_NOT_ALLOWED",
                  "STALE_VERSION",
                  "IDEMPOTENCY_CONFLICT",
                  "CONFLICT",
                  "PAYLOAD_TOO_LARGE",
                  "UNSUPPORTED_MEDIA_TYPE",
                  "PRECONDITION_REQUIRED",
                  "RATE_LIMITED",
                  "INTERNAL",
                  "UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              },
              "fieldErrors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              },
              "requestId": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "current": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "type": "integer"
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

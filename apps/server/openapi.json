    "/api/v1/auth/password/set": {
      "post": {
        "operationId": "staffSetPassword",
        "summary": "Set a password with an invite or reset link",
        "description": "Consumes the single-use link, checks the length-based policy, stores the argon2id hash, activates an invited account and revokes every session: the person then signs in again.",

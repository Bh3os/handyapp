{
  "name": "@handyhub/server",
  "private": true,
  "type": "module",
  "description": "Fastify server: the API and the host for the public site, the customer portal and the staff app (ARCH-STACK).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:int": "vitest run test/integration --no-file-parallelism",
    "perf": "vitest run test/perf --no-file-parallelism --silent=false",
    "start": "node dist/main.js",
    "openapi": "pnpm --filter '@handyhub/server...' run build && node dist/cli/openapi.js",
    "data-inventory": "pnpm --filter '@handyhub/server...' run build && node dist/cli/data-inventory.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@fastify/static": "^10.1.5",
    "@handyhub/db": "workspace:*",
    "@handyhub/domain": "workspace:*",
    "@handyhub/i18n": "workspace:*",
    "@handyhub/money": "workspace:*",
    "@handyhub/policy": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "fastify": "^5.12.5",
    "kysely": "^0.29.7",
    "otpauth": "9.5.2",
    "pdfkit": "0.20.2",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "vite": "^8.3.2"
  }
}

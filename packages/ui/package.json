{
  "name": "@handyhub/ui",
  "private": true,
  "type": "module",
  "description": "Design system: tokens, components and functional states shared by the public site, the portal and the staff app (HH-BASE-01).",
  "exports": {
    ".": {
      "@handyhub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/index.css",
    "./tokens.css": "./styles/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config gallery/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:preview": "vite preview --config gallery/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  }
}

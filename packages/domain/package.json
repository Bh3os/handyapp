{
  "name": "@handyhub/domain",
  "private": true,
  "type": "module",
  "description": "Per-entity state machines and transition policies.",
  "exports": {
    ".": {
      "@handyhub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./request-form": {
      "@handyhub/source": "./src/request-form.ts",
      "types": "./dist/request-form.d.ts",
      "default": "./dist/request-form.js"
    },
    "./legal": {
      "@handyhub/source": "./src/legal.ts",
      "types": "./dist/legal.d.ts",
      "default": "./dist/legal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}

{
  "name": "@handyhub/db",
  "private": true,
  "type": "module",
  "description": "PostgreSQL 16 access through Kysely, numbered SQL migrations and the test database harness.",
  "exports": {
    ".": {
      "@handyhub/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@handyhub/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./seed/services.json": "./seed/services.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/unit",
    "test:int": "vitest run test/integration --no-file-parallelism",
    "db:migrate": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "db:seed": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/seed.js",
    "db:types": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/types.js",
    "db:services": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/services.js",
    "db:sops": "pnpm run build && node --env-file-if-exists=../../.env dist/cli/sops.js"
  },
  "dependencies": {
    "kysely": "^0.29.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
